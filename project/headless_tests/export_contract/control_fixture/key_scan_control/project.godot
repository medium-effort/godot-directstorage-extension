; Throwaway fixture for the pack scanner's positive control.
; Not shipped and not part of the addon: it exists only to produce a pack that
; carries the key-file magic in the clear, which the scanner must reject.

config_version=5

[application]

config/name="Key Scan Control"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[editor_plugins]

enabled=PackedStringArray("res://addons/control_exporter/plugin.cfg")
