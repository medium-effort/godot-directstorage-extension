; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but for the simple cases, you can contain settings here.

config_version=5

[application]

config/name="DirectStorage Accelerator Demo"
config/description="Microsoft DirectStorage NVMe I/O Acceleration Addon for Godot 4.7"
config/author="MediumEffort"
run/main_scene="res://test_scenes/test_texture_load.tscn"
config/features=PackedStringArray("4.7", "Forward+")
config/icon="res://addons/directstorage_accelerator/icons/DirectStorage.svg"

[autoload]

DSBatchManager="*res://addons/directstorage_accelerator/scripts/ds_batch_manager.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/directstorage_accelerator/plugin.cfg")

[rendering]

renderer/rendering_method="forward_plus"
