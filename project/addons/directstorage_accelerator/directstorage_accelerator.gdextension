[configuration]
entry_symbol = "directstorage_accelerator_init"
compatibility_minimum = "4.3"
reloadable = true

[libraries]
; Windows binary names below are generated from ADDON_BINARY_STEM /
; ADDON_BINARY_ARCH_SUFFIX / ADDON_BINARY_DEBUG_SUFFIX in SConstruct — keep in sync.
windows.editor.x86_64 = "bin/dsgd_64.debug.dll"
windows.debug.x86_64 = "bin/dsgd_64.debug.dll"
windows.release.x86_64 = "bin/dsgd_64.dll"
linux.editor.x86_64 = "bin/libdirectstorage_accelerator.linux.editor.x86_64.so"
linux.debug.x86_64 = "bin/libdirectstorage_accelerator.linux.template_debug.x86_64.so"
linux.release.x86_64 = "bin/libdirectstorage_accelerator.linux.template_release.x86_64.so"
macos.editor = "bin/libdirectstorage_accelerator.macos.editor.universal.dylib"
macos.debug = "bin/libdirectstorage_accelerator.macos.template_debug.universal.dylib"
macos.release = "bin/libdirectstorage_accelerator.macos.template_release.universal.dylib"

[dependencies]
windows.editor.x86_64 = {"bin/dstorage.dll": "", "bin/dstoragecore.dll": ""}
windows.debug.x86_64 = {"bin/dstorage.dll": "", "bin/dstoragecore.dll": ""}
windows.release.x86_64 = {"bin/dstorage.dll": "", "bin/dstoragecore.dll": ""}
