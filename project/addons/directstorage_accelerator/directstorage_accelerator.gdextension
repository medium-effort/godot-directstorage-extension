[configuration]
entry_symbol = "directstorage_accelerator_init"
compatibility_minimum = "4.3"
reloadable = true

[libraries]
; Library names below are generated from the ADDON_BINARY_* constants in
; SConstruct — keep in sync. SCons supplies the POSIX "lib" prefix and the
; platform extension on Linux/macOS; the stem and debug tag match Windows.
windows.editor.x86_64 = "bin/dsgd_64.debug.dll"
windows.debug.x86_64 = "bin/dsgd_64.debug.dll"
windows.release.x86_64 = "bin/dsgd_64.dll"
linux.editor.x86_64 = "bin/libdsgd_64.debug.so"
linux.debug.x86_64 = "bin/libdsgd_64.debug.so"
linux.release.x86_64 = "bin/libdsgd_64.so"
macos.editor = "bin/libdsgd_64.debug.dylib"
macos.debug = "bin/libdsgd_64.debug.dylib"
macos.release = "bin/libdsgd_64.dylib"

[dependencies]
windows.editor.x86_64 = {"bin/dstorage.dll": "", "bin/dstoragecore.dll": ""}
windows.debug.x86_64 = {"bin/dstorage.dll": "", "bin/dstoragecore.dll": ""}
windows.release.x86_64 = {"bin/dstorage.dll": "", "bin/dstoragecore.dll": ""}
