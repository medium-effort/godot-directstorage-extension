[node name="TitleLabel" type="Label" parent="Layout/Header"]
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "DirectStorage Texture Migration Tool"

[node name="DescLabel" type="Label" parent="Layout/Header"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.75, 0.75, 1)
theme_override_font_sizes/font_size = 12
text = "Select project textures to migrate from Godot's default texture importer to DirectStorage. Original .import files are safely packed into a ZIP archive in the dsgd addon folder, preserving exact UIDs so scenes, materials, and scripts stay 100% compatible."
autowrap_mode = 3

