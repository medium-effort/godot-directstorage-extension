[gd_scene format=3]

[ext_resource type="Script" path="res://main.gd" id="1_main"]

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_main")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 24

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "DirectStorage vs. Standard CPU Loading"

[node name="BackendLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Backend: ..."

[node name="Controls" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="RunButton" type="Button" parent="Margin/VBox/Controls"]
unique_name_in_owner = true
layout_mode = 2
text = "Run A/B Comparison"

[node name="LoadingDemoButton" type="Button" parent="Margin/VBox/Controls"]
unique_name_in_owner = true
layout_mode = 2
text = "Loading Screen Demo"

[node name="StatusLabel" type="Label" parent="Margin/VBox/Controls"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "Ready"

[node name="Body" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 16

[node name="ResultsBox" type="RichTextLabel" parent="Margin/VBox/Body"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
bbcode_enabled = true
scroll_following = true

[node name="PreviewRect" type="TextureRect" parent="Margin/VBox/Body"]
unique_name_in_owner = true
custom_minimum_size = Vector2(256, 256)
layout_mode = 2
expand_mode = 1
stretch_mode = 5
