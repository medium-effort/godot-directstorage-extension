# Environment-Driven Build Pipeline Configuration
# Copy this file to .env and adjust the values for your setup.
# .env is gitignored and will never be committed.

# --- Pipeline Mode ---
# 0 (default): build locally with SCons on this machine.
# 1 / true / yes: offload builds to a remote host via SSH/SCP.
REMOTE_BUILD=0

# --- Remote SSH (only used when REMOTE_BUILD=1) ---
REMOTE_HOST=user@remote-machine.local
REMOTE_HOST_FALLBACK=user@remote-machine          # Or Tailscale IP: user@100.x.y.z
REMOTE_DIR=D:/builds/my-project

# --- Post-Build Sync ---
# Deployment step of the build pipeline (build_remote.ps1 step [6/6]), run after
# a successful build by tools/sync_artifacts.py. Running `scons` directly never
# syncs. Enabled by default (1). Set to 0 to disable without removing the paths.
# Each sync target only runs when its path variable is explicitly defined.
ENABLE_POST_BUILD_ADDON_SYNC=1
# Full project mirror target (e.g. integration test project).
SYNC_TEST_DIR=D:/path/to/directstorage-test
# Copyable addon + src mirror target.
SYNC_ADDON_COPYABLE_DIR=D:/path/to/directstorage-addon-copyable-windows
# External addon target (e.g. TPS demo project).
SYNC_ADDON_DIR=D:/path/to/godot-project/addons/directstorage_accelerator

# --- Local Godot / Safety ---
GODOT_CONSOLE_PATH=D:/path/to/godot-console-executable

# Hard fail scons when trying to run it on this device
PREVENT_BUILD_ON_THIS_DEVICE=0

# --- Baked archive key (legacy source build only) ---
# Not needed for archive encryption. The supported path never puts the key in the
# binary: every export generates a fresh 32-byte archive key and delivers it inside
# the encrypted PCK as res://.dspkg/toc.key. Leave this empty and there is nothing
# else to configure.
#
# Set it only when deliberately building a source build with a FIXED KEY COMPILED
# INTO THE DLL - for experiments, or when there is no encrypted PCK to carry a key.
# The addon's shipped binaries carry no key, and the build audit fails an editor,
# template_debug or template_release DLL that carries one. (Godot's own export
# templates are separate - those are built with your PCK key on purpose.) At
# runtime a readable PCK key entry still wins over a baked one.
#
# The file: plain UTF-8 text, whole content = 64 hex characters (a 256-bit key).
# Name and extension are irrelevant - `.key` is only a convention - and trailing
# whitespace or a final newline is ignored. Generate one (never commit it, and keep
# a backup: losing it makes archives built with it unreadable):
#   New-Item -ItemType Directory -Force .keys | Out-Null
#   $b = New-Object byte[] 32
#   [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#   ($b | ForEach-Object { $_.ToString('x2') }) -join '' | Set-Content .keys\dspkg_encryption.key
DSPKG_ENCRYPTION_KEY_FILE=