# clangd configuration for godot-directstorage-extension

# Treat thirdparty and godot-cpp include paths as system headers to suppress
# warnings originating inside external headers when included by src/ files.
CompileFlags:
  Add:
    - -imsvc
    - godot-cpp/include
    - -imsvc
    - godot-cpp/gen/include
    - -imsvc
    - thirdparty/directstorage/include
    - -imsvc
    - thirdparty/gdeflate
    - -imsvc
    - thirdparty/libdeflate

---
# Suppress diagnostics and skip background indexing for files inside godot-cpp/
If:
  PathMatch: .*/godot-cpp/.*
Diagnostics:
  Suppress: "*"
Index:
  Background: Skip
CompileFlags:
  Add:
    - -w

---
# Suppress diagnostics and skip background indexing for files inside thirdparty/
If:
  PathMatch: .*/thirdparty/.*
Diagnostics:
  Suppress: "*"
Index:
  Background: Skip
CompileFlags:
  Add:
    - -w
