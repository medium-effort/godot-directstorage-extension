# SCons & Python Build Cache
# ==============================================================================
.sconsign.dblite
.sconf_temp/
/__pycache__
compile_commands.json

# ==============================================================================
# C/C++ Compiled Objects & MSVC Build Artifacts
# ==============================================================================
*.obj
*.obj.import
*.o
*.os
*.idb
*.pdb
*.ilk
*.exp

# ==============================================================================
# Generated Source Files & Documentation Data
# ==============================================================================
src/gen/
*.gen.cpp
*.gen.h

# ==============================================================================
# Compiled GDExtension Target Outputs & Binaries
# ==============================================================================
project/addons/directstorage_accelerator/bin/directstorage_accelerator.*
project/addons/directstorage_accelerator/bin/dsgd*
project/addons/directstorage_accelerator/bin/libdsgd*
project/addons/directstorage_accelerator/bin/*.lib
project/addons/directstorage_accelerator/bin/build_manifest.json
project/addons/directstorage_accelerator/bin/*.dll.old
project/addons/directstorage_accelerator/bin/~*
# Runtime installer state (local to each checkout, never part of the addon).
project/addons/directstorage_accelerator/bin/.versions/
project/addons/directstorage_accelerator/bin/.pending.json
project/addons/directstorage_accelerator/bin/.runtime.json
# Migration tool backup archive folder (contains user .import backups and .gdignore).
project/addons/directstorage_accelerator/.migration_backup/

# ==============================================================================
# DirectStorage SDK Runtime & Import Library (fetched, never committed)
# ==============================================================================
# The headers stay committed (MIT). These files are covered by the Microsoft
# package EULA; dstorage.lib is not in the package's distributable_files.txt.
# Fetch them with tools/fetch_directstorage.ps1 (or the VS Code task
# "Fetch DirectStorage Runtime").
thirdparty/directstorage/bin/x64/*.dll
thirdparty/directstorage/lib/x64/*.lib
project/addons/directstorage_accelerator/bin/dstorage.dll
project/addons/directstorage_accelerator/bin/dstoragecore.dll

# ==============================================================================
# Godot Runtime Cache, Imports & Project Outputs
# ==============================================================================
.godot/
.import/
/project/exports
project/test_assets/*.glb
project/test_assets/*.png
project/demo_generated/
*.dspkg
*.dstex

# ==============================================================================
# Godot Local Addons
# ==============================================================================
# Allowlist: ignore every addon directory except the accelerator itself.
# The parent directory must NOT be ignored, otherwise the negated entry below
# could never be re-included.
/project/addons/*
!/project/addons/directstorage_accelerator/

# ==============================================================================
# Test Frameworks & Static Analysis (gdextest, cppcheck, logs)
# ==============================================================================
build/gdextest/
build/release_smoke/
# gdextest test libraries. libdirectstorage_tests* = pre-dsgd leftovers, kept
# ignored so a stale artifact never resurfaces as untracked.
bin/libdsgd_tests*
bin/libdirectstorage_tests*
gdextest_matrix.json
test-results.xml
project/gut-results.xml
src/cppcheck_result.xml
/logs

